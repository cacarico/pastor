<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The herdr server as a launchd user agent, for a Mac in the flock.

  `pastor setup launchd` with its herdr flag installs this to
  ~/Library/LaunchAgents/ and loads it. On the way it points ProgramArguments
  at the herdr found on PATH, adds an EnvironmentVariables PATH copied from
  that shell, so the agents herdr launches (claude, codex, ...) resolve the
  way they do interactively, and sends output to
  ~/Library/Logs/pastor.herdr.log. Installing by hand works too: fix the
  program path, then `launchctl bootstrap gui/$(id -u) <this file>`.

  Stopping this agent stops every agent it runs. A LaunchAgent runs while you
  are logged in and starts again at login.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>pastor.herdr</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/herdr</string>
		<string>server</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
