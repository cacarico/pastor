# pastor serve as a systemd user unit, for the head.
#
# `pastor setup systemd` installs this to ~/.config/systemd/user/ and enables
# it. On the way it points ExecStart at the pastor binary it was run as and
# adds an Environment=PATH= line copied from that shell, so `ssh` and `herdr`
# resolve the way they do interactively. Installing by hand works too: fix the
# ExecStart path, then `systemctl --user enable --now pastor.service`.
#
# A user unit stops at logout unless lingering is on: `loginctl enable-linger`.
#
# ssh runs with BatchMode=yes, so it cannot ask for a passphrase: give the
# unit an agent (Environment=SSH_AUTH_SOCK=...) or use a key without one.
#
# Hardening: only what works in a user unit without user namespaces and
# leaves pastor's writes alone. ProtectSystem=strict would stop ssh updating
# ~/.ssh/known_hosts and connectors writing their caches, PrivateTmp would
# hide a state dir kept under /tmp from the CLI, and ProtectHome would hide
# ~/.ssh; all three also need unprivileged user namespaces, which some hosts
# turn off, and the unit would then not start at all.

[Unit]
Description=pastor: run coding agents on machines you own
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/pastor serve
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
UMask=0077
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
